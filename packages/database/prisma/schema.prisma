  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaCents Int
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([modifierGroupId, name])
  @@index([modifierGroupId, active, sortOrder])
  @@map("modifiers")
}

model RestaurantOrder {
  id                 String                @id @default(uuid())
  idempotencyKey     String?
  requestFingerprint String?
  restaurantTabId    String
  restaurantTab      RestaurantTab         @relation(fields: [restaurantTabId], references: [id], onDelete: Restrict)
  showtimeSeatId     String?
  showtimeSeat       ShowtimeSeat?         @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)
  serverEmployeeId   String?
  serverEmployee     Employee?             @relation(fields: [serverEmployeeId], references: [id], onDelete: Restrict)
  source             RestaurantOrderSource @default(STAFF)
  ticketOrderId      String?
  ticketOrder        TicketOrder?          @relation(fields: [ticketOrderId], references: [id], onDelete: Restrict)
  status             RestaurantOrderStatus @default(DRAFT)
  placedAt           DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  items              RestaurantOrderItem[]
  fulfillmentTickets FulfillmentTicket[]

  @@unique([restaurantTabId, idempotencyKey])
  @@index([restaurantTabId, status])
  @@index([showtimeSeatId, status])
  @@index([serverEmployeeId, createdAt])
