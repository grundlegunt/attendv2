  status                 RestaurantOrderItemStatus @default(DRAFT)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  fulfillmentTickets     FulfillmentTicket[]

  @@unique([restaurantOrderId, idempotencyKey])
  @@index([restaurantOrderId, status])
  @@index([kitchenStationId, status])
  @@map("restaurant_order_items")
