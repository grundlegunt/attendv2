model FulfillmentTicket {
  id                 String                  @id @default(uuid())
  idempotencyKey     String?
  requestFingerprint String?
  restaurantOrderId  String
  restaurantOrder    RestaurantOrder         @relation(fields: [restaurantOrderId], references: [id], onDelete: Restrict)
  kitchenStationId   String
  kitchenStation     KitchenStation          @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  tabLabel           String?
  auditoriumName     String?
  seatLabels         String[]
  showtimeId         String?
  showtimeStartsAt   DateTime?
  serverName         String
  status             FulfillmentTicketStatus @default(NEW)
  firedAt            DateTime                @default(now())
  acceptedAt         DateTime?
  startedAt          DateTime?
  readyAt            DateTime?
  deliveredAt        DateTime?
  refireCount        Int                     @default(0)
  refiredFromId      String?
  refiredFrom        FulfillmentTicket?      @relation("FulfillmentRefires", fields: [refiredFromId], references: [id], onDelete: Restrict)
  refires            FulfillmentTicket[]     @relation("FulfillmentRefires")
  items              RestaurantOrderItem[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([refiredFromId, idempotencyKey])
  @@index([kitchenStationId, status, firedAt])
  @@index([restaurantOrderId, status])
  @@index([refiredFromId])
  @@map("fulfillment_tickets")
}

model RestaurantReceipt {
  id                 String        @id @default(uuid())
  restaurantTabId    String        @unique
  restaurantTab      RestaurantTab @relation(fields: [restaurantTabId], references: [id], onDelete: Restrict)
  receiptNumber      String        @unique
  subtotalCents      Int
  taxCents           Int
  serviceChargeCents Int
  tipCents           Int
  totalCents         Int
  tenderSummary      Json
  emailClaimedAt     DateTime?
  emailSentAt        DateTime?
  emailMessageId     String?
  emailError         String?
  issuedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([emailSentAt, emailClaimedAt, updatedAt])
  @@index([emailSentAt, emailError, updatedAt])
  @@map("restaurant_receipts")
}

model CustomerAuthAccount {
  id String @id @default(uuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Nullable: an OAuth-only account (Milestone 0 supports password auth;
  // OAuth providers are a later addition per /docs/SECURITY.md §1) has no
  // local password hash.
  passwordHash String?

  emailVerifiedAt DateTime?
  mfaEnabled      Boolean   @default(false)

  refreshTokenVersion Int @default(0)

  passwordResetRequestId      String?
  passwordResetTokenVersion   Int?
  passwordResetEmailClaimedAt DateTime?
  passwordResetEmailSentAt    DateTime?
  passwordResetEmailMessageId String?
  passwordResetEmailError     String?

  emailChangeRequestId      String?
  emailChangeNewEmail       String?
  emailChangeTokenVersion   Int?
  emailChangeEmailClaimedAt DateTime?
  emailChangeEmailSentAt    DateTime?
  emailChangeEmailMessageId String?
  emailChangeEmailError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passwordResetEmailSentAt, passwordResetEmailClaimedAt, updatedAt], map: "customer_auth_password_reset_claim_idx")
  @@index([emailChangeEmailSentAt, emailChangeEmailClaimedAt, updatedAt], map: "customer_auth_email_change_claim_idx")
  @@map("customer_auth_accounts")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditActorType {
  EMPLOYEE
  CUSTOMER
  PLATFORM
  SYSTEM
}

model AuditEvent {
  id String @id @default(uuid())

  actorType AuditActorType
  // Employee.id, Customer.id, PlatformUser.id, or null for SYSTEM.
  actorId   String?

  action     String // e.g. "employee.login", "ticket.refunded"
  entityType String // e.g. "Employee", "Ticket"
  entityId   String

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Never contains payment credentials — see /docs/SECURITY.md §9.
  beforeState Json?
  afterState  Json?

  occurredAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([locationId, occurredAt])
  @@map("audit_events")
}
