  menuCategoryId   String
  menuCategory     MenuCategory             @relation(fields: [menuCategoryId], references: [id], onDelete: Restrict)
  kitchenStationId String
  kitchenStation   KitchenStation           @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  name             String
  description      String?
  imageUrl         String?
  priceCents       Int
  chargeCategory   RestaurantChargeCategory @default(FOOD)
  isVegan          Boolean                  @default(false)
  isGlutenFree     Boolean                  @default(false)
  active           Boolean                  @default(true)
  is86d            Boolean                  @default(false)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  modifierGroups ModifierGroup[]
  orderItems     RestaurantOrderItem[]
  moviePairings  MoviePairing[]

