// Milestone 5 schema.
// Scope: identity/RBAC, cinema configuration, concurrency-safe seat holds,
// ticket checkout, ticket issuance records, and payment state.
//
// Conventions (see /docs/DATA_MODEL.md):
//  - UUID primary keys.
//  - createdAt/updatedAt on every model.
//  - Money fields are always integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & Location
// ---------------------------------------------------------------------------

model Organization {
  id                       String                  @id @default(uuid())
  name                     String
  legalName                String?
  businessTypeLabel        String?
  defaultSeatingMode       AuditoriumSeatingMode   @default(RESERVED)
  timezone                 String                  @default("America/New_York")
  stripeConnectedAccountId String?
  connectOnboardingStatus  ConnectOnboardingStatus @default(NOT_STARTED)
  ticketFeeMinor           Int                     @default(0)
  registeredTicketFeeMinor Int                     @default(0)
  active                   Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  locations         Location[]
  roles             Role[]
  movies            Movie[]
  filmSeries        FilmSeries[]
  priceTiers        PriceTier[]
  paymentCustomers  PaymentCustomer[]
  giftCards         GiftCard[]
  giftCardPurchases GiftCardPurchase[]
  memberships       Membership[]

  @@map("organizations")
}

// Attend company operators are intentionally separate from cinema employees.
// They have cross-organization visibility only through the dedicated platform
// API and can never be assigned a cinema role or location permission.
model PlatformUser {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  passwordHash        String
  role                PlatformUserRole @default(OWNER)
  active              Boolean          @default(true)
  refreshTokenVersion Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("platform_users")
}

enum PlatformUserRole {
  OWNER
  OPERATOR
  VIEWER
}

model FilmSeries {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  artworkUrl     String?
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  showtimes      Showtime[]

  @@unique([organizationId, name])
  @@index([organizationId, active, sortOrder])
  @@map("film_series")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                        String
  address                     String?
  customerLogoUrl             String?
  customerAccentColor         String?
  customerAccentMutedColor    String?
  customerBackgroundColor     String?
  customerBackgroundGlowColor String?
  customerSurfaceColor        String?
  customerTextColor           String?
  customerMutedTextColor      String?
  adminAccentColor            String?
  adminAccentMutedColor       String?
  adminBackgroundColor        String?
  adminSurfaceColor           String?
  adminTextColor              String?
  adminMutedTextColor         String?
  adminUiConfig               Json?
  brandingDraft               Json?
  brandingDraftedAt           DateTime?
  contentDraft                Json?
  contentPublished            Json?
  contentPublishedAt          DateTime?
  diningMenuAssetUrl          String?
  diningMenuAssetType         String?
  timezone                    String    @default("America/New_York")
  currency                    String    @default("USD")
  // Configured by the operator. Zero is a deliberate safe default until the
  // location's tax treatment has been confirmed; the application never
  // invents a jurisdictional tax rate.
  ticketTaxRateBasisPoints    Int       @default(0)

  // Turnover scheduling config — see /docs/DATA_MODEL.md "Showtime scheduling
  // & turnover". Used from Milestone 1 onward; defined here now since it's a
  // Location-level setting.
  cleaningBufferMinutes     Int     @default(15)
  preShowBufferMinutes      Int     @default(30)
  checkDropMinutesBeforeEnd Int     @default(30)
  autoSettleGraceMinutes    Int     @default(5)
  autoSettleTipBasisPoints  Int     @default(0)
  timeClockEnabled          Boolean @default(true)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees             Employee[]
  employeeRoles         EmployeeRole[]
  auditEvents           AuditEvent[]
  expenses              Expense[]
  auditoriums           Auditorium[]
  ticketTypes           TicketType[]
  ticketOrders          TicketOrder[]
  restaurantTabs        RestaurantTab[]
  kitchenStations       KitchenStation[]
  menuCategories        MenuCategory[]
  taxRules              TaxRule[]
  serviceChargeRules    ServiceChargeRule[]
  cashDrawers           CashDrawer[]
  cashTransactions      CashTransaction[]
  promotions            Promotion[]
  shifts                Shift[]
  privateEventInquiries PrivateEventInquiry[]
  issuedGiftCards       GiftCard[]
  giftCardTransactions  GiftCardTransaction[]
  giftCardPurchases     GiftCardPurchase[]
  schedulePlans         SchedulePlan[]

  @@map("locations")
}

enum ExpenseCategory {
  FILM_RENTAL
  FOOD_BEVERAGE
  PAYROLL
  OCCUPANCY
  MARKETING
  EQUIPMENT
  MAINTENANCE
  UTILITIES
  INSURANCE
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  locationId  String
  location    Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  vendor      String?
  description String
  amountCents Int
  incurredAt  DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([locationId, incurredAt])
  @@map("expenses")
}

model SchedulePlan {
  id           String   @id @default(uuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name         String
  weekStartsAt DateTime
  snapshotJson Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([locationId, weekStartsAt, name])
  @@index([locationId, weekStartsAt])
  @@map("schedule_plans")
}

model PrivateEventInquiry {
  id            String    @id @default(uuid())
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  name          String
  email         String
  phone         String?
  eventType     String
  preferredDate DateTime?
  guestCount    Int?
  message       String
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([locationId, status, createdAt])
  @@map("private_event_inquiries")
}

enum GiftCardStatus {
  ACTIVE
  DEACTIVATED
}

enum GiftCardTransactionType {
  ISSUANCE
  REDEMPTION
  REFUND
  ADJUSTMENT
}

enum GiftCardPurchaseStatus {
  AWAITING_PAYMENT
  PAID
  DELIVERED
  DELIVERY_FAILED
}

model GiftCard {
  id                    String                @id @default(uuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  issuedAtLocationId    String
  issuedAtLocation      Location              @relation(fields: [issuedAtLocationId], references: [id], onDelete: Restrict)
  codeHash              String                @unique
  codeLast4             String
  initialBalanceCents   Int
  balanceCents          Int
  currency              String                @default("USD")
  recipientName         String?
  recipientEmail        String?
  status                GiftCardStatus        @default(ACTIVE)
  issuedByEmployeeId    String?
  issuedByEmployee      Employee?             @relation(fields: [issuedByEmployeeId], references: [id], onDelete: Restrict)
  issuanceRequestId     String?               @unique
  issuanceCodeEncrypted String?
  transactions          GiftCardTransaction[]
  ticketOrders          TicketOrder[]
  purchase              GiftCardPurchase?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, codeLast4])
  @@map("gift_cards")
}

model GiftCardPurchase {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId            String
  location              Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  paymentId             String                 @unique
  payment               Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  giftCardId            String?                @unique
  giftCard              GiftCard?              @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  amountCents           Int
  currency              String                 @default("USD")
  buyerEmail            String
  recipientName         String?
  recipientEmail        String
  message               String?
  status                GiftCardPurchaseStatus @default(AWAITING_PAYMENT)
  idempotencyKey        String                 @unique
  deliveryMessageId     String?
  deliveryCodeEncrypted String?
  deliveryClaimedAt     DateTime?
  deliveredAt           DateTime?
  deliveryError         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([organizationId, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([deliveryClaimedAt])
  @@index([deliveredAt, deliveryClaimedAt, updatedAt])
  @@index([status, deliveredAt, updatedAt])
  @@map("gift_card_purchases")
}

model GiftCardTransaction {
  id                String                  @id @default(uuid())
  giftCardId        String
  giftCard          GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type              GiftCardTransactionType
  amountCents       Int
  balanceAfterCents Int
  employeeId        String?
  employee          Employee?               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reference         String?
  createdAt         DateTime                @default(now())

  @@index([giftCardId, createdAt])
  @@index([locationId, createdAt])
  @@map("gift_card_transactions")
}

// ---------------------------------------------------------------------------
// Cinema configuration (Milestone 1)
// ---------------------------------------------------------------------------

enum SeatType {
  STANDARD
  ADA
  COMPANION
}

enum TablePosition {
  LEFT
  RIGHT
}

enum ConnectOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  RESTRICTED
}

model Auditorium {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  name        String
  capacity    Int
  seatingMode AuditoriumSeatingMode @default(RESERVED)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  seatMap   SeatMap?
  showtimes Showtime[]

  @@unique([locationId, name])
  @@index([locationId, active])
  @@map("auditoriums")
}

enum AuditoriumSeatingMode {
  RESERVED
  GENERAL_ADMISSION
}

model SeatMap {
  id           String     @id @default(uuid())
  auditoriumId String     @unique
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)

  name       String
  version    Int      @default(1)
  // Operational geometry belongs here; sellable positions remain normalized
  // as Seat records below. Previous geometry is retained in SeatMapRevision.
  layoutJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seats     Seat[]
  revisions SeatMapRevision[]

  @@map("seat_maps")
}

model SeatMapRevision {
  id        String  @id @default(uuid())
  seatMapId String
  seatMap   SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)

  version    Int
  layoutJson Json?
  createdAt  DateTime @default(now())

  @@unique([seatMapId, version])
  @@index([seatMapId, createdAt])
  @@map("seat_map_revisions")
}

model Seat {
  id        String  @id @default(uuid())
  seatMapId String
  seatMap   SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)

  label         String
  rowLabel      String
  number        Int
  x             Int
  y             Int
  type          SeatType @default(STANDARD)
  layoutVersion Int      @default(1)
  levelKey      String?
  sectionKey    String?

  tableGroupId  String?
  tablePosition TablePosition?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  showtimeSeats ShowtimeSeat[]

  @@unique([seatMapId, layoutVersion, label])
  @@unique([seatMapId, layoutVersion, levelKey, x, y])
  @@index([seatMapId, layoutVersion, rowLabel, number])
  @@map("seats")
}

enum MovieArtworkPosition {
  TOP_LEFT
  TOP
  TOP_RIGHT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  BOTTOM_LEFT
  BOTTOM
  BOTTOM_RIGHT
}

model Movie {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  title                   String
  synopsis                String?
  runtimeMinutes          Int
  rating                  String?
  posterUrl               String?
  detailPosterUrl         String?
  posterPosition          MovieArtworkPosition @default(CENTER)
  detailPosterPosition    MovieArtworkPosition @default(CENTER)
  diningSpecialArtworkUrl String?
  diningSpecialTitle      String?
  director                String?
  starring                String?
  trailerUrl              String?
  releaseYear             Int?
  distributorName         String?
  distributorTerms        Json?
  active                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  showtimes Showtime[]
  pairings  MoviePairing[]

  @@index([organizationId, active])
  @@map("movies")
}

model PriceTier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name               String
  ticketPriceMinor   Int
  feeMinor           Int
  registeredFeeMinor Int      @default(0)
  currency           String   @default("USD")
  // JavaScript weekday numbers: Sunday 0 through Saturday 6.
  // Empty means the default tier.
  appliesOnWeekdays  Int[]
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  showtimes Showtime[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("price_tiers")
}

model Showtime {
  id           String     @id @default(uuid())
  movieId      String
  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Restrict)
  auditoriumId String
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Restrict)
  priceTierId  String
  priceTier    PriceTier  @relation(fields: [priceTierId], references: [id], onDelete: Restrict)

  // startsAt is the advertised customer start. The feature begins after
  // Location.preShowBufferMinutes.
  startsAt        DateTime
  featureStartsAt DateTime
  endsAt          DateTime
  roomReadyAt     DateTime
  onSale          Boolean                 @default(false)
  filmSeriesId    String?
  filmSeries      FilmSeries?             @relation(fields: [filmSeriesId], references: [id], onDelete: Restrict)
  presentation    String                  @default("STANDARD")
  format          String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  showtimeSeats   ShowtimeSeat[]
  restaurantTabs  RestaurantTab[]
  waitlistEntries ShowtimeWaitlistEntry[]

  @@index([auditoriumId, startsAt])
  @@index([movieId, startsAt])
  @@map("showtimes")
}

enum ShowtimeWaitlistStatus {
  ACTIVE
  NOTIFIED
  CANCELLED
  EXPIRED
}

model ShowtimeWaitlistEntry {
  id                    String                 @id @default(uuid())
  showtimeId            String
  showtime              Showtime               @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  email                 String
  status                ShowtimeWaitlistStatus @default(ACTIVE)
  expiresAt             DateTime
  requestId             String                 @unique
  requestFingerprint    String
  notifiedAt            DateTime?
  notificationClaimedAt DateTime?
  notificationMessageId String?
  notificationError     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([showtimeId, email])
  @@index([status, expiresAt, createdAt])
  @@index([status, notificationClaimedAt, createdAt])
  @@map("showtime_waitlist_entries")
}

model ShowtimeSeat {
  id               String              @id @default(uuid())
  showtimeId       String
  showtime         Showtime            @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId           String
  seat             Seat                @relation(fields: [seatId], references: [id], onDelete: Restrict)
  blockedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  holds            SeatHold[]
  tickets          Ticket[]
  tabSeats         RestaurantTabSeat[] @relation("TabSeatMembership")
  currentTabSeatId String?             @unique
  currentTabSeat   RestaurantTabSeat?  @relation("CurrentTabSeat", fields: [currentTabSeatId], references: [id], onDelete: Restrict)
  restaurantOrders RestaurantOrder[]

  @@unique([showtimeId, seatId])
  @@index([showtimeId, blockedAt])
  @@map("showtime_seats")
}

model SeatHold {
  id             String       @id @default(uuid())
  showtimeSeatId String
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Cascade)
  holdToken      String       @unique
  holderKey      String
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([showtimeSeatId, expiresAt, releasedAt])
  @@index([holderKey, expiresAt])
  @@map("seat_holds")
}

// ---------------------------------------------------------------------------
// Ticketing and payments (Milestone 3)
// ---------------------------------------------------------------------------

enum TicketOrderChannel {
  ONLINE
  BOX_OFFICE
}

enum TicketOrderStatus {
  CART
  AWAITING_PAYMENT
  PAYMENT_FAILED
  PAID
  EXPIRED
  ABANDONED
  PARTIALLY_REFUNDED
  REFUNDED
  EXCHANGED
}

enum TicketStatus {
  ISSUED
  ADMITTED
  REFUNDED
  TRANSFERRED
  CANCELED
}

enum TicketScanResult {
  VALID
  ALREADY_USED
  WRONG_SHOWTIME
  REFUNDED
  CANCELED
  INVALID
}

enum CashDrawerStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  SALE
  REFUND
  PAID_IN
  PAID_OUT
}

enum PromotionType {
  FIXED_AMOUNT
  PERCENTAGE
  COMP
}

enum ShiftClockMethod {
  PIN
  BADGE
  MANAGER_OVERRIDE
}

enum PaymentPurpose {
  TICKET_ORDER
  RESTAURANT_TAB
  GIFT_CARD_PURCHASE
}

enum PaymentStatus {
  CREATED
  REQUIRES_PAYMENT_METHOD
  REQUIRES_ACTION
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RefundScope {
  TICKET
  RESTAURANT
  BOTH
}

enum CustomerConsentType {
  DINING_AUTO_SETTLEMENT
  TERMS_OF_SERVICE
  MARKETING
  SMS_TICKET_DELIVERY
}

enum RestaurantTabType {
  SEAT_LINKED
  WALK_IN
}

enum RestaurantTabStatus {
  PREAUTHORIZED
  OPEN
  READY_TO_CLOSE
  SETTLEMENT_PENDING
  PAYMENT_FAILED
  MANAGER_REVIEW
  CLOSED
  REFUNDED
  VOIDED
}

enum RestaurantFulfillmentMode {
  SEAT_DELIVERY
  COUNTER_PICKUP
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum RestaurantOrderStatus {
  DRAFT
  SENT
  IN_PROGRESS
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELED
}

enum RestaurantOrderSource {
  STAFF
  ONLINE_ORDER_AHEAD
}

enum RestaurantOrderItemStatus {
  DRAFT
  SENT
  VOIDED
  COMPED
}

enum RestaurantChargeCategory {
  FOOD
  ALCOHOL
  NA_BEVERAGE
}

enum RestaurantChargeAppliesTo {
  ALL
  FOOD
  ALCOHOL
  NA_BEVERAGE
}

enum FulfillmentTicketStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  CANCELED
  VOIDED
  REFIRE
}

model TicketType {
  id                   String   @id @default(uuid())
  locationId           String
  location             Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  name                 String
  priceAdjustmentMinor Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders  TicketOrder[]
  tickets Ticket[]

  @@unique([locationId, name])
  @@index([locationId, active])
  @@map("ticket_types")
}

model TicketOrder {
  id           String     @id @default(uuid())
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  holdTokens                   String[]
  // Per-held-seat admission types are persisted before payment so retries
  // and asynchronous finalization always issue the originally quoted mix.
  ticketTypeSelections         Json?
  holderKey                    String
  guestEmail                   String?
  guestName                    String?
  guestPhone                   String?
  smsTicketsRequested          Boolean             @default(false)
  zipCode                      String?
  receiptEmailClaimedAt        DateTime?
  receiptEmailSentAt           DateTime?
  receiptEmailMessageId        String?
  receiptEmailError            String?
  mobileAccessTokenHash        String?              @unique
  mobileAccessExpiresAt        DateTime?
  mobileAccessRevokedAt        DateTime?
  receiptResendRequestId       String?
  receiptResendActorType       AuditActorType?
  receiptResendActorId         String?
  receiptResendPreviousEmail   String?
  // Captures the explicit checkout choice so Milestone 5 can create the
  // versioned CustomerConsent and saved payment reference after confirmation.
  diningAuthorizationRequested Boolean?
  channel                      TicketOrderChannel @default(ONLINE)
  status                       TicketOrderStatus  @default(CART)
  orderNumber                  String             @unique
  checkoutIdempotencyKey       String             @unique

  subtotalCents Int
  feesCents     Int
  taxCents      Int
  totalCents    Int
  discountCents Int    @default(0)
  currency      String @default("USD")

  // Trusted, server-quoted food-and-beverage basket captured with checkout.
  // Ticket subtotal, fees, and tax remain separate for box-office reporting.
  orderAheadItems              Json?
  orderAheadSubtotalCents      Int   @default(0)
  orderAheadTaxCents           Int   @default(0)
  orderAheadServiceChargeCents Int   @default(0)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  giftCardId    String?
  giftCard      GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  giftCardCents Int       @default(0)

  placedByEmployeeId String?
  placedByEmployee   Employee? @relation(fields: [placedByEmployeeId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tickets          Ticket[]
  payment          Payment?
  consents         CustomerConsent[]
  cashTransactions CashTransaction[]
  restaurantOrders RestaurantOrder[]

  @@index([locationId, createdAt])
  @@index([customerId, createdAt])
  @@index([giftCardId, createdAt])
  @@index([receiptEmailSentAt, receiptEmailClaimedAt, updatedAt])
  @@index([receiptEmailSentAt, receiptEmailError, updatedAt])
  @@index([mobileAccessExpiresAt, mobileAccessRevokedAt])
  @@map("ticket_orders")
}

model Ticket {
  id             String       @id @default(uuid())
  ticketOrderId  String
  ticketOrder    TicketOrder  @relation(fields: [ticketOrderId], references: [id], onDelete: Restrict)
  showtimeSeatId String
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)
  ticketTypeId   String
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  priceCentsPaid Int
  status         TicketStatus        @default(ISSUED)
  qrToken        String              @unique
  issuedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  scans          TicketScan[]
  tabSeats       RestaurantTabSeat[]

  @@index([ticketOrderId])
  @@index([showtimeSeatId, status])
  @@map("tickets")
}

model TicketScan {
  id                    String           @id @default(uuid())
  ticketId              String?
  ticket                Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  scannedByEmployeeId   String
  scannedByEmployee     Employee         @relation(fields: [scannedByEmployeeId], references: [id], onDelete: Restrict)
  expectedShowtimeId    String
  deviceId              String?
  entrance              String?
  credentialFingerprint String
  result                TicketScanResult
  scannedAt             DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([ticketId, scannedAt])
  @@index([scannedByEmployeeId, scannedAt])
  @@map("ticket_scans")
}

model PaymentCustomer {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider           String
  providerCustomerId String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  paymentMethods PaymentMethodReference[]

  @@unique([organizationId, customerId, provider])
  @@unique([organizationId, provider, providerCustomerId])
  @@map("payment_customers")
}

model PaymentMethodReference {
  id                      String          @id @default(uuid())
  paymentCustomerId       String
  paymentCustomer         PaymentCustomer @relation(fields: [paymentCustomerId], references: [id], onDelete: Restrict)
  provider                String
  providerPaymentMethodId String
  brand                   String
  last4                   String
  expMonth                Int
  expYear                 Int
  isDefault               Boolean         @default(false)
  active                  Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  payments       Payment[]
  consents       CustomerConsent[]
  restaurantTabs RestaurantTab[]

  @@unique([paymentCustomerId, provider, providerPaymentMethodId])
  @@index([paymentCustomerId, active])
  @@map("payment_method_references")
}

model Payment {
  id                       String                  @id @default(uuid())
  purpose                  PaymentPurpose
  ticketOrderId            String?                 @unique
  ticketOrder              TicketOrder?            @relation(fields: [ticketOrderId], references: [id], onDelete: Restrict)
  restaurantTabId          String?
  restaurantTab            RestaurantTab?          @relation(fields: [restaurantTabId], references: [id], onDelete: Restrict)
  amountCents              Int
  tipCents                 Int?
  currency                 String                  @default("USD")
  status                   PaymentStatus           @default(CREATED)
  paymentMethodReferenceId String?
  paymentMethodReference   PaymentMethodReference? @relation(fields: [paymentMethodReferenceId], references: [id], onDelete: Restrict)
  idempotencyKey           String                  @unique
  provider                 String
  providerPaymentId        String?

  // Round 2 review fixes: durable "needs human review" signal, set by
  // finalizeOrder when a succeeded PaymentIntent's amount, currency, or
  // metadata don't match this order's expected charge (see
  // TicketingService.finalizeOrder) -- the money may genuinely have
  // moved while no ticket was ever issued, which must never be
  // traceable only through logs. Deliberately additive fields, not a new
  // PaymentStatus value: this is an orthogonal review flag, not a
  // payment-processing lifecycle state. Cleared automatically the next
  // time finalizeOrder re-checks this payment and the mismatch is gone.
  verificationFailedAt    DateTime?
  verificationFailureNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts         PaymentAttempt[]
  refunds          Refund[]
  giftCardPurchase GiftCardPurchase?

  @@index([status, createdAt])
  @@index([restaurantTabId, status])
  @@index([verificationFailedAt])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents      Int
  reason           String
  scope            RefundScope  @default(TICKET)
  status           RefundStatus @default(CREATED)
  idempotencyKey   String       @unique
  providerRefundId String?

  // Round 2 review fixes: claim lease for the refund-reconciliation job
  // (TicketingService.reconcilePendingRefunds / apps/api's
  // RefundReconciliationService) -- lets a stuck CREATED/PROCESSING
  // refund (the process died before ever calling the provider, or after
  // the provider responded but before the local status update committed)
  // be safely resumed without a second concurrent reconciliation pass
  // racing the same row. Null or in the past means unclaimed/claimable; a
  // future timestamp means some in-flight attempt owns it until then.
  leaseExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId, status])
  @@index([status, leaseExpiresAt])
  // Round 2 review fixes: lets the async refund-status webhook find the
  // local row by the provider's refund id when it can't rely on
  // metadata.
  @@index([providerRefundId])
  @@map("refunds")
}

model PaymentAttempt {
  id               String               @id @default(uuid())
  paymentId        String
  payment          Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider         String
  providerIntentId String
  attemptNumber    Int
  status           PaymentAttemptStatus @default(CREATED)
  failureCode      String?
  failureMessage   String?
  attemptedAt      DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([paymentId, attemptNumber])
  @@unique([provider, providerIntentId])
  @@map("payment_attempts")
}

model ProcessedWebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("processed_webhook_events")
}

// ---------------------------------------------------------------------------
// Staff identity, roles, permissions
// ---------------------------------------------------------------------------

model Employee {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  name   String
  email  String  @unique
  active Boolean @default(true)

  dashboardPreferences Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  authAccount             StaffAuthAccount?
  employeeRoles           EmployeeRole[]
  placedTicketOrders      TicketOrder[]
  ticketScans             TicketScan[]
  restaurantOrders        RestaurantOrder[]
  droppedRestaurantChecks RestaurantTab[]       @relation("DroppedRestaurantChecks")
  openedCashDrawers       CashDrawer[]          @relation("OpenedCashDrawers")
  closedCashDrawers       CashDrawer[]          @relation("ClosedCashDrawers")
  cashTransactions        CashTransaction[]
  shifts                  Shift[]               @relation("EmployeeShifts")
  adjustedShifts          Shift[]               @relation("AdjustedShifts")
  issuedGiftCards         GiftCard[]
  giftCardTransactions    GiftCardTransaction[]

  @@map("employees")
}

model StaffAuthAccount {
  id String @id @default(uuid())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // argon2id hash — never a plaintext password, never reversible.
  // See /docs/SECURITY.md §1.
  passwordHash       String
  pinHash            String?
  mustChangePassword Boolean @default(false)

  mfaEnabled         Boolean @default(false)
  // Encrypted TOTP secret at rest. Required for OWNER / GENERAL_MANAGER /
  // ACCOUNTING roles per /docs/SECURITY.md §1 — enforcement of "required"
  // happens in application logic (Milestone 0 auth module), not the schema.
  mfaSecretEncrypted String?

  refreshTokenVersion Int @default(0) // bump to invalidate all outstanding refresh tokens (logout-everywhere)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_auth_accounts")
}

model CashDrawer {
  id                   String            @id @default(uuid())
  locationId           String
  location             Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  registerId           String
  status               CashDrawerStatus  @default(OPEN)
  openingBalanceCents  Int
  closingBalanceCents  Int?
  expectedBalanceCents Int?
  openedByEmployeeId   String
  openedByEmployee     Employee          @relation("OpenedCashDrawers", fields: [openedByEmployeeId], references: [id], onDelete: Restrict)
  closedByEmployeeId   String?
  closedByEmployee     Employee?         @relation("ClosedCashDrawers", fields: [closedByEmployeeId], references: [id], onDelete: Restrict)
  openedAt             DateTime          @default(now())
  closedAt             DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  transactions         CashTransaction[]

  @@index([locationId, registerId, status])
  @@map("cash_drawers")
}

model CashTransaction {
  id                String              @id @default(uuid())
  locationId        String
  location          Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cashDrawerId      String
  cashDrawer        CashDrawer          @relation(fields: [cashDrawerId], references: [id], onDelete: Restrict)
  ticketOrderId     String?
  ticketOrder       TicketOrder?        @relation(fields: [ticketOrderId], references: [id], onDelete: Restrict)
  employeeId        String
  employee          Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type              CashTransactionType
  amountCents       Int
  cashReceivedCents Int?
  changeGivenCents  Int?
  reason            String?
  idempotencyKey    String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([cashDrawerId, createdAt])
  @@index([ticketOrderId])
  @@map("cash_transactions")
}

model Promotion {
  id                    String        @id @default(uuid())
  locationId            String
  location              Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  code                  String
  name                  String
  type                  PromotionType
  amountCents           Int?
  percentageBasisPoints Int?
  minimumSubtotalCents  Int?
  maximumRedemptions    Int?
  active                Boolean       @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  ticketOrders          TicketOrder[]

  @@unique([locationId, code])
  @@index([locationId, active])
  @@map("promotions")
}

model Shift {
  id                   String           @id @default(uuid())
  employeeId           String
  employee             Employee         @relation("EmployeeShifts", fields: [employeeId], references: [id], onDelete: Restrict)
  locationId           String
  location             Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  clockInAt            DateTime
  clockOutAt           DateTime?
  clockInMethod        ShiftClockMethod @default(PIN)
  breakStartAt         DateTime?
  breakEndAt           DateTime?
  adjustedByEmployeeId String?
  adjustedByEmployee   Employee?        @relation("AdjustedShifts", fields: [adjustedByEmployeeId], references: [id], onDelete: Restrict)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([employeeId, clockInAt])
  @@index([locationId, clockInAt])
  @@map("shifts")
}

// Roles are organization-defined (an org could rename/reorganize roles over
// time) but the *permissions* a role can be granted are a fixed, code-defined
// catalog (see @cinema/auth) — never user-editable. This is a deliberate
// anti-privilege-escalation choice; see /docs/OPEN_QUESTIONS.md §5 (risks).
model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Seeded roles use @cinema/auth's fixed RoleKey values; cinema-created
  // roles receive an opaque CUSTOM_* key and still draw permissions only
  // from the fixed Permission catalog.
  key  String
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  employeeRoles   EmployeeRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  // e.g. "ticket.refund", "menu.edit", "employee.permissions.edit" — matches
  // the Permission enum in @cinema/auth exactly. Seeded from that catalog,
  // never created ad hoc through any admin UI.
  key String @unique

  description String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Roles are assignable per location (multi-location future, see
  // /docs/ARCHITECTURE.md and /docs/OPEN_QUESTIONS.md §1).
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([employeeId, roleId, locationId])
  @@map("employee_roles")
}

// ---------------------------------------------------------------------------
// Customer identity
// ---------------------------------------------------------------------------

model Customer {
  id    String  @id @default(uuid())
  email String? @unique
  phone String?
  name  String?

  isGuest Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  authAccount      CustomerAuthAccount?
  ticketOrders     TicketOrder[]
  paymentCustomers PaymentCustomer[]
  consents         CustomerConsent[]
  restaurantTabs   RestaurantTab[]
  memberships      Membership[]

  @@map("customers")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELED
}

// Read-only representation of a membership issued by the cinema or an
// external membership system. Attend does not sell or renew memberships.
model Membership {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membershipNumber String
  tier             String
  status           MembershipStatus @default(ACTIVE)
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, membershipNumber])
  @@unique([organizationId, customerId])
  @@index([customerId, status])
  @@map("memberships")
}

model CustomerConsent {
  id                       String                  @id @default(uuid())
  customerId               String
  customer                 Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type                     CustomerConsentType
  granted                  Boolean
  termsVersion             String
  grantedAt                DateTime
  ticketOrderId            String?
  ticketOrder              TicketOrder?            @relation(fields: [ticketOrderId], references: [id], onDelete: Restrict)
  paymentMethodReferenceId String?
  paymentMethodReference   PaymentMethodReference? @relation(fields: [paymentMethodReferenceId], references: [id], onDelete: Restrict)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@unique([ticketOrderId, type])
  @@index([customerId, type, grantedAt])
  @@index([ticketOrderId])
  @@map("customer_consents")
}

model RestaurantTab {
  id                           String                    @id @default(uuid())
  idempotencyKey               String?
  requestFingerprint           String?
  locationId                   String
  location                     Location                  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  primaryCustomerId            String?
  primaryCustomer              Customer?                 @relation(fields: [primaryCustomerId], references: [id], onDelete: Restrict)
  tabType                      RestaurantTabType
  fulfillmentMode              RestaurantFulfillmentMode @default(SEAT_DELIVERY)
  showtimeId                   String?
  showtime                     Showtime?                 @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  label                        String?
  status                       RestaurantTabStatus
  autoSettleAuthorized         Boolean                   @default(false)
  activePaymentMethodId        String?
  activePaymentMethod          PaymentMethodReference?   @relation(fields: [activePaymentMethodId], references: [id], onDelete: Restrict)
  activePaymentMethodSetAt     DateTime?
  autoSettleAt                 DateTime?
  checkDroppedAt               DateTime?
  checkDroppedByEmployeeId     String?
  checkDroppedByEmployee       Employee?                 @relation("DroppedRestaurantChecks", fields: [checkDroppedByEmployeeId], references: [id], onDelete: Restrict)
  selectedTipCents             Int?
  subtotalCents                Int?
  taxCents                     Int?
  serviceChargeCents           Int?
  totalCents                   Int?
  paymentFailureEmailClaimedAt DateTime?
  paymentFailureEmailSentAt    DateTime?
  paymentFailureEmailMessageId String?
  paymentFailureEmailError     String?
  // Amount already collected through a combined ticket + dining payment.
  // This remains separate from staff-entered tab payments so settlement can
  // subtract it without representing a second processor charge.
  prepaidCents                 Int                       @default(0)
  openedAt                     DateTime                  @default(now())
  closedAt                     DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  seats           RestaurantTabSeat[]
  payments        Payment[]
  receipt         RestaurantReceipt?
  orders          RestaurantOrder[]
  mergedTabs      RestaurantTab[]     @relation("MergedRestaurantTabs")
  mergedIntoTabId String?
  mergedIntoTab   RestaurantTab?      @relation("MergedRestaurantTabs", fields: [mergedIntoTabId], references: [id], onDelete: Restrict)

  @@unique([locationId, idempotencyKey])
  @@index([locationId, status, openedAt])
  @@index([showtimeId, status])
  @@index([status, paymentFailureEmailSentAt, paymentFailureEmailClaimedAt, updatedAt], map: "restaurant_tabs_payment_failure_email_claim_idx")
  @@index([status, paymentFailureEmailSentAt, paymentFailureEmailError, updatedAt], map: "restaurant_tabs_payment_failure_email_retry_idx")
  @@map("restaurant_tabs")
}

model RestaurantTabSeat {
  id              String        @id @default(uuid())
  restaurantTabId String
  restaurantTab   RestaurantTab @relation(fields: [restaurantTabId], references: [id], onDelete: Restrict)
  showtimeSeatId  String
  showtimeSeat    ShowtimeSeat  @relation("TabSeatMembership", fields: [showtimeSeatId], references: [id], onDelete: Restrict)
  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  currentForSeat  ShowtimeSeat? @relation("CurrentTabSeat")

  @@unique([showtimeSeatId, restaurantTabId])
  @@unique([ticketId, restaurantTabId])
  @@index([restaurantTabId])
  @@map("restaurant_tab_seats")
}

model KitchenStation {
  id          String   @id @default(uuid())
