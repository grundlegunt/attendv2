NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinema
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-secret-at-least-32-characters
QR_CREDENTIAL_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
EMAIL_PROVIDER=postmark
# POSTMARK_API_TEST validates the full request without delivering email.
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
EMAIL_FROM=receipts@example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
CHECKOUT_RATE_LIMIT_ATTEMPTS=30
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
OBSERVABILITY_TOKEN=replace-with-an-independent-random-token-at-least-32-characters
ERROR_ALERT_WEBHOOK_URL=

# Keep test mode until the production launch gate is explicitly approved.
# Live mode is accepted only with NODE_ENV=production and matching live keys.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
PAYMENT_METHOD_DOMAINS=localhost
# Server-only upstream used by the customer-web same-origin API proxy.
CUSTOMER_API_UPSTREAM_URL=http://127.0.0.1:4000/api/v1
# Public customer website used by Admin and Attend Master launch links.
NEXT_PUBLIC_CUSTOMER_WEB_URL=http://localhost:3000
# Server-side base URL used for customer recovery emails. The public value
# above remains a compatibility fallback for existing deployments.
CUSTOMER_WEB_URL=http://localhost:3000
