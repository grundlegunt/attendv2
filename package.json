{
  "name": "dine-in-cinema-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "multer": "^2.2.0",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "postinstall": "pnpm --filter @cinema/database run generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:load": "node tests/load/opening-night.mjs",
    "db:migrate": "pnpm --filter @cinema/database migrate:dev",
    "db:seed": "pnpm --filter @cinema/database seed",
    "platform-user:create": "pnpm --filter @cinema/database platform-user:create",
    "db:generate": "pnpm --filter @cinema/database generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "otplib": "^12.0.1",
    "turbo": "^2.10.11",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0"
  }
}
