{
  "name": "@cinema/customer-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @cinema/database generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app --ext .ts,.tsx",
    "test": "node --test test/*.spec.cjs"
  },
  "dependencies": {
    "@cinema/auth": "workspace:*",
    "@cinema/config": "workspace:*",
    "@cinema/database": "workspace:*",
    "@cinema/notifications": "workspace:*",
    "@cinema/payments": "workspace:*",
    "@cinema/shared": "workspace:*",
    "@cinema/ticketing": "workspace:*",
    "@cinema/ui": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.6.3"
  }
}
