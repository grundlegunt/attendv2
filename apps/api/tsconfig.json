{
  "extends": "../../packages/config/tsconfig-base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
