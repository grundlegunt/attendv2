# Copy to apps/api/.env for local development. Never commit the real .env
# file (see AGENTS.md §4 / SECURITY.md §6) — this file holds placeholders
# only.

NODE_ENV=development
PORT=4000

# Matches infra/docker-compose.yml's postgres service.
DATABASE_URL=postgresql://cinema:cinema_dev_password@localhost:5432/cinema_dev

# Matches infra/docker-compose.yml's redis service. Not yet consumed by any
# code in Milestone 0 — required by the env schema for when it is (seat
# holds, Milestone 2).
REDIS_URL=redis://localhost:6379

# Generate real values with: openssl rand -base64 48
# Must be at least 32 characters. Access and refresh secrets must differ.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-character-secret
QR_CREDENTIAL_SECRET=replace-with-an-independent-random-32+-character-secret
EMAIL_PROVIDER=postmark
SMS_PROVIDER=disabled
# Required only when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TICKET_RECONCILIATION_INTERVAL_MS=60000
APPLE_WALLET_PROVIDER=disabled
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.cinema
# APPLE_WALLET_WWDR_CERTIFICATE_BASE64=
# APPLE_WALLET_CERTIFICATE_BASE64=
# APPLE_WALLET_PRIVATE_KEY_BASE64=
# APPLE_WALLET_PRIVATE_KEY_PASSWORD=
# APPLE_WALLET_ICON_BASE64=
# APPLE_WALLET_ICON_2X_BASE64=
GOOGLE_WALLET_PROVIDER=disabled
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
# Use POSTMARK_API_TEST in development to validate without delivering.
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
EMAIL_FROM=receipts@example.com

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Use STRIPE_MODE=live only in production with matching sk_live_/pk_live_
# credentials. Test mode is the safe default for development and staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MODE=test

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
CHECKOUT_RATE_LIMIT_ATTEMPTS=30
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
OBSERVABILITY_TOKEN=replace-with-an-independent-random-token-at-least-32-characters

# How often RefundReconciliationService sweeps for stuck refunds, in
# milliseconds. Set to 0 to disable the background sweep (e.g. in tests
# that drive reconciliation explicitly).
REFUND_RECONCILIATION_INTERVAL_MS=60000

# How often failed online gift-card email deliveries are retried. Set to 0
# to disable the background sweep.
GIFT_CARD_DELIVERY_RECONCILIATION_INTERVAL_MS=60000

# How often failed online ticket receipt emails are retried. Set to 0 to
# disable the background sweep.
TICKET_RECEIPT_RECONCILIATION_INTERVAL_MS=60000
