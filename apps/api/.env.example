# Copy to apps/api/.env for local development. Never commit the real .env
# file (see AGENTS.md §4 / SECURITY.md §6) — this file holds placeholders
# only.

NODE_ENV=development
PORT=4000

# Matches infra/docker-compose.yml's postgres service.
DATABASE_URL=postgresql://cinema:cinema_dev_password@localhost:5432/cinema_dev

# Matches infra/docker-compose.yml's redis service. Not yet consumed by any
# code in Milestone 0 — required by the env schema for when it is (seat
# holds, Milestone 2).
REDIS_URL=redis://localhost:6379

# Generate real values with: openssl rand -base64 48
# Must be at least 32 characters. Access and refresh secrets must differ.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-character-secret

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Stripe test-mode keys only — see PAYMENT_FLOW.md. Not required until
# Milestone 3.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# How often RefundReconciliationService sweeps for stuck refunds, in
# milliseconds. Set to 0 to disable the background sweep (e.g. in tests
# that drive reconciliation explicitly).
REFUND_RECONCILIATION_INTERVAL_MS=60000
